# Copie este arquivo para ".env" e preencha com os valores reais.
# Nunca commite o arquivo ".env" com valores reais.

# String de conexão do Postgres via pooler do Supabase (pgbouncer, porta 6543).
# Usada pela aplicação em runtime (queries).
# No painel do Supabase: Project Settings > Database > Connection string > Transaction pooler.
DATABASE_URL="postgresql://usuario:senha@host:6543/nome_do_banco?pgbouncer=true"

# String de conexão direta com o Postgres (sem pooler, porta 5432).
# Usada pela CLI do Prisma (migrate, studio, db execute) — o pgbouncer em modo
# transaction não suporta bem as operações de migração.
# No painel do Supabase: Project Settings > Database > Connection string > Direct connection.
DIRECT_URL="postgresql://usuario:senha@host:5432/nome_do_banco"

# Chave usada para assinar o cookie de sessão (JWT). Gere uma com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="troque_por_uma_chave_aleatoria_de_32_bytes"
